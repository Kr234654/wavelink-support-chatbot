# The app works without any key (rule-based replies). Add a key to get real AI replies.

# OpenAI:
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Groq (OpenAI-compatible). Check the Groq docs for current model names:
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant

# Password for the agent dashboard (open the site and go to /#agent). CHANGE THIS before deploying.
ADMIN_KEY=demo-admin

# Websites allowed to call this API (comma separated). Add your Netlify URL after deploying.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Messages allowed per minute for each visitor
RATE_LIMIT_PER_MIN=20
